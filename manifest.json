{
  "manifest_version": 3,
  "name": "Capture Screenshot",
  "version": "1.0",
  "description": "Capture viewport, region, or full page. Download or copy.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "debugger"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
